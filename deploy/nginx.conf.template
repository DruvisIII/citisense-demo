server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_proxied any;
    gzip_vary on;
    gzip_types text/plain text/css application/javascript application/json
               application/manifest+json application/wasm image/svg+xml
               font/ttf font/otf application/octet-stream;

    # Never cache the entry files, so a redeploy reaches testers at once.
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        expires off;
    }
    location = /flutter_service_worker.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        expires off;
    }
    location = /version.json {
        add_header Cache-Control "no-cache, no-store, must-revalidate" always;
        expires off;
    }
    location = /flutter_bootstrap.js {
        add_header Cache-Control "no-cache" always;
    }
    location = /main.dart.js {
        add_header Cache-Control "no-cache" always;
    }
    location = /manifest.json {
        add_header Cache-Control "no-cache" always;
    }

    # Long cache for static assets (images, fonts, CanvasKit).
    location ~* \.(?:png|jpg|jpeg|gif|webp|svg|ico|ttf|otf|woff2?|wasm)$ {
        add_header Cache-Control "public, max-age=2592000" always;
        try_files $uri =404;
    }

    location = /healthz {
        access_log off;
        return 200 "ok";
    }

    # Single-page app: unknown paths load the app.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
